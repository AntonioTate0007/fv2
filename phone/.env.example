# Copy to .env and fill in:   cp .env.example .env
# Everything is optional except the Telegram token if you want to talk to Jarvis
# from Telegram (the terminal REPL works with nothing set).

# ── Telegram ───────────────────────────────────────────────────────────────────
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your personal chat id — the ONLY chat Jarvis obeys. Send the bot /start and it
# tells you the id to paste here.
TELEGRAM_CHAT_ID=

# ── Brain ──────────────────────────────────────────────────────────────────────
# auto   → rules first (instant, offline), then local model, then Gemini
# rules  → regex intents only, no model at all
# local  → OpenAI-compatible server on the phone (llama-server, cactus, …)
# gemini → Google Gemini over the network
JARVIS_BRAIN=auto

# Local model server (OpenAI-compatible /chat/completions). llama-server's default:
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=local
LOCAL_LLM_TIMEOUT=60

# Gemini (https://aistudio.google.com). Used by the "gemini" brain and as the
# last fallback in "auto".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Fortress server (optional) ─────────────────────────────────────────────────
# Lets Jarvis answer "how am I doing", list positions and run the swarm by
# calling your Fortress backend (Pi, Render, or the same phone).
FORTRESS_URL=
FORTRESS_API_TOKEN=

# ── Behaviour ──────────────────────────────────────────────────────────────────
JARVIS_NAME=Jarvis
# Speak every reply out loud through the phone (termux-tts-speak). on/off
JARVIS_SPEAK=off
# Daily spoken briefing, 24h local time, e.g. 07:30. Blank = off.
JARVIS_MORNING_BRIEF=
# Allow the sms_send tool (always asks for confirmation first). on/off
JARVIS_ALLOW_SMS=off
# Where notes, reminders and chat memory live.
JARVIS_DATA_DIR=~/.jarvis
